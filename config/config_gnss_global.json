{
  // enable_yaw_prior    : If true, constrain the heading of submaps with the heading (orientation) of the GNSS pose messages
  // yaw_prior_sigma_deg : Sigma of the yaw prior [deg] (used when dynamic_scale is false, or when the message has no valid yaw covariance)
  // yaw_min_sigma_deg   : Lower bound of the sigma derived from the message yaw covariance [deg] (dynamic_scale = true)
  // yaw_max_sigma_deg   : Yaw priors with a larger sigma are not created [deg]
  // isShow              : If true, draw the GNSS constraints in the viewer
  //                       position prior: submap -> GNSS position line + cross (cyan: normal, orange: weak, red: abandoned)
  //                       yaw prior     : magenta line from the submap along the GNSS heading
  "gnss": {
    "gnss_topic": "/localization/pose_with_covariance_stamped",
    "min_baseline": 3.0,
    "dynamic_scale":true,
    "prior_inf_scale": [
      2e4,
      2e4,
      4e5
    ],
    "enable_yaw_prior": true,
    "yaw_prior_sigma_deg": 1.0,
    "yaw_min_sigma_deg": 0.5,
    "yaw_max_sigma_deg": 5.0,
    "isShow": true
  }
}
